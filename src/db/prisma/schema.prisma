// Prisma Schema for Adaptive C1 English Learning Platform
// Configured for PostgreSQL (Supabase / local / cloud)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Initial Phase 0 System Verification Model
model SystemHealth {
  id        String   @id @default(cuid())
  status    String   @default("ok")
  checkedAt DateTime @default(now())

  @@map("system_health")
}
