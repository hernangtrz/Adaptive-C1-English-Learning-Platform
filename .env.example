# Database Connection (Supabase / PostgreSQL)
# Transaction pooler URL (port 6543) or direct session URL
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?schema=public"
# Direct URL for Prisma migrations (port 5432)
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# NextAuth / Auth.js Configuration
NEXTAUTH_SECRET="development-secret-key-change-in-production-min-32-chars-long"
NEXTAUTH_URL="http://localhost:3000"

# Application Environment
NODE_ENV="development"

# AI Provider API Keys (Optional in Phase 0, used in Speaking & Writing phases)
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""
